        <company-info>
            <text font-family="Arial" font-size="14pt" font-weight="bold" color="#002C6C">PT ASURANSI JIWA ASTRA</text>
            <text font-family="Arial" font-size="9pt" color="#666666">Pondok Indah Office Tower 3, Lantai 1, Jl. Sultan Iskandar Muda Kav. V-TA, Jakarta 12310</text>
            <text font-family="Arial" font-size="9pt" color="#666666">Call Center: 1-500-282 | www.astralife.co.id</text>
